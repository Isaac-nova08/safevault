<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SafeVault.Core\SafeVault.Core.csproj" />
    <ProjectReference Include="..\SafeVault.Security\SafeVault.Security.csproj" />
    <ProjectReference Include="..\SafeVault.Data\SafeVault.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SafeVault.App</RootNamespace>
    <AssemblyName>SafeVault</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SafeVault.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Version>1.0.0</Version>
    <Product>SafeVault</Product>
    <Description>Gestionnaire de mots de passe local et hors ligne.</Description>

    <!-- En développement, l'application n'est pas empaquetée (F5 direct dans Visual Studio).
         Le paquet MSIX est produit par build/publish.ps1 (WindowsPackageType=MSIX). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SafeVault.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
