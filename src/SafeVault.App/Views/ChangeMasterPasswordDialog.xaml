<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SafeVault.App.Views.ChangeMasterPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SafeVault.App.Views"
    Title="Changer le Master Password"
    PrimaryButtonText="Changer"
    CloseButtonText="Annuler"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="14" Width="420">
        <PasswordBox x:Name="CurrentInput"
                     Header="Master Password actuel"
                     Password="{x:Bind ViewModel.CurrentPassword, Mode=TwoWay}" />

        <StackPanel Spacing="6">
            <PasswordBox Header="Nouveau Master Password"
                         Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay}" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Maximum="4" VerticalAlignment="Center"
                             Value="{x:Bind ViewModel.StrengthValue, Mode=OneWay}"
                             Foreground="{x:Bind views:CreateVaultPage.StrengthBrush(ViewModel.Strength), Mode=OneWay}" />
                <TextBlock Grid.Column="1" MinWidth="70" TextAlignment="Right"
                           Text="{x:Bind ViewModel.StrengthLabel, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.PolicyHint, Mode=OneWay}" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <PasswordBox Header="Confirmez le nouveau Master Password"
                         Password="{x:Bind ViewModel.Confirmation, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind ViewModel.MismatchHint, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                 Message="Vos identifiants restent intacts : seule la protection de la clé du coffre change." />

        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" />
    </StackPanel>
</ContentDialog>
