<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SafeVault.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Raccourcis clavier : Ctrl+F (rechercher), Ctrl+N (ajouter, sur le bouton), Ctrl+L (verrouiller) -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnSearchAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnLockAccelerator" />
    </Page.KeyboardAccelerators>

    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Left"
        OpenPaneLength="240"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="OnSelectionChanged"
        ItemInvoked="OnItemInvoked">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="DashboardItem" Content="Tableau de bord" Tag="Dashboard" Icon="Home" />
            <NavigationViewItem x:Name="AllItem" Content="Tous les identifiants" Tag="AllCredentials">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D7;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="FavoritesItem" Content="Favoris" Tag="Favorites" Icon="Favorite" />
            <NavigationViewItem x:Name="GeneratorItem" Content="Générateur" Tag="Generator">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE945;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="SettingsItem" Content="Paramètres" Tag="Settings" Icon="Setting" />
            <NavigationViewItem Content="Verrouiller" Tag="Lock" SelectsOnInvoked="False"
                                ToolTipService.ToolTip="Verrouiller (Ctrl+L)">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE72E;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barre supérieure : recherche et ajout -->
            <Grid Padding="32,16,32,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    MaxWidth="480"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Rechercher un service, un identifiant, une URL… (Ctrl+F)"
                    QueryIcon="Find"
                    AutomationProperties.Name="Rechercher"
                    Text="{x:Bind ViewModel.State.SearchText, Mode=TwoWay}"
                    TextChanged="OnSearchTextChanged" />

                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Ajouter"
                        Command="{x:Bind ViewModel.AddCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Ajouter" />
                    </StackPanel>
                </Button>

                <!-- Menu du coffre : état, paramètres, verrouillage -->
                <DropDownButton Grid.Column="2" AutomationProperties.Name="Mon coffre"
                                ToolTipService.ToolTip="Mon coffre">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE785;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="Mon coffre" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Coffre déverrouillé" IsEnabled="False">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE785;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Paramètres et sauvegardes" Icon="Setting" Click="OnOpenSettings" />
                            <MenuFlyoutItem Text="Verrouiller" KeyboardAcceleratorTextOverride="Ctrl+L"
                                            Command="{x:Bind ViewModel.LockCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Entrées illisibles (fichier du coffre altéré) -->
                <InfoBar Margin="32,16,32,0" Severity="Warning" IsClosable="True"
                         Title="Données altérées"
                         IsOpen="{x:Bind ViewModel.HasUnreadableEntries, Mode=OneWay}"
                         Message="{x:Bind ViewModel.UnreadableMessage, Mode=OneWay}" />

                <Frame x:Name="ContentFrame" Grid.Row="1" Padding="32,20,32,24" />
            </Grid>

            <!-- Notification brève (copie dans le presse-papiers…) -->
            <InfoBar x:Name="Notification" Grid.Row="1"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24"
                     MaxWidth="640" Severity="Success" IsOpen="False" />
        </Grid>
    </NavigationView>
</Page>
