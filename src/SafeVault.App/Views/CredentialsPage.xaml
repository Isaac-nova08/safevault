<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SafeVault.App.Views.CredentialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SafeVault.App.Views"
    xmlns:vm="using:SafeVault.App.ViewModels">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête : titre, nombre de résultats, filtre -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Bottom"
                      AutomationProperties.Name="Filtrer par catégorie"
                      ItemsSource="{x:Bind ViewModel.CategoryOptions, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryOption">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Liste -->
        <ListView Grid.Row="1"
                  Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.Items}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CredentialItemViewModel">
                    <views:CredentialRow Item="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- État vide -->
        <StackPanel Grid.Row="1" Spacing="12" MaxWidth="360"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE8D7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button HorizontalAlignment="Center" Content="Ajouter un identifiant"
                    Command="{x:Bind ViewModel.AddCommand}" />
        </StackPanel>
    </Grid>
</Page>
