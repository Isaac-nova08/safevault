<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SafeVault.App.Views.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SafeVault.App.Views">

    <Grid Padding="24">
        <StackPanel
            Width="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">

            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-256_altform-unplated.png"
                       Width="80" Height="80" HorizontalAlignment="Center" />
                <TextBlock Text="SafeVault" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Votre coffre est verrouillé."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <PasswordBox
                x:Name="PasswordInput"
                PlaceholderText="Master Password"
                Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                IsEnabled="{x:Bind views:UnlockPage.Not(ViewModel.IsBusy), Mode=OneWay}"
                KeyDown="OnPasswordKeyDown" />

            <Button
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.Name="Déverrouiller"
                Command="{x:Bind ViewModel.UnlockCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock Text="Déverrouiller" />
                </StackPanel>
            </Button>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
