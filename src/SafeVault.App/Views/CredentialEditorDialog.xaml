<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SafeVault.App.Views.CredentialEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SafeVault.Core.Models"
    Title="{x:Bind ViewModel.Title}"
    PrimaryButtonText="Enregistrer"
    CloseButtonText="Annuler"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Width="440" Padding="0,0,12,0">
            <TextBox
                x:Name="ServiceNameInput"
                Header="Nom du service *"
                PlaceholderText="Google, GitHub, Banque…"
                MaxLength="200"
                Text="{x:Bind ViewModel.ServiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox
                Header="Nom d'utilisateur ou email *"
                MaxLength="320"
                Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox
                    Header="Mot de passe *"
                    MaxLength="1024"
                    PasswordRevealMode="Peek"
                    Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                <Button Grid.Column="1" VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.GeneratePasswordCommand}"
                        ToolTipService.ToolTip="Générer un mot de passe robuste"
                        AutomationProperties.Name="Générer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE945;" FontSize="14" />
                        <TextBlock Text="Générer" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBox
                Header="URL du site"
                PlaceholderText="https://"
                MaxLength="2048"
                InputScope="Url"
                Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                Header="Catégorie"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Categories}"
                SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox
                Header="Note"
                Height="96"
                MaxLength="10000"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Content="Ajouter aux favoris" IsChecked="{x:Bind ViewModel.IsFavorite, Mode=TwoWay}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
