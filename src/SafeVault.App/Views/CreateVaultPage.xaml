<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SafeVault.App.Views.CreateVaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SafeVault.App.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24">
            <Border
                MaxWidth="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="36,32"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">

                <StackPanel Spacing="16">
                    <!-- En-tête -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-256_altform-unplated.png"
                               Width="64" Height="64" HorizontalAlignment="Center" />
                        <TextBlock Text="Créer votre coffre" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Choisissez un Master Password : c'est le seul mot de passe dont vous aurez besoin pour accéder à tous les autres."
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Master Password -->
                    <StackPanel Spacing="6">
                        <PasswordBox
                            x:Name="PasswordInput"
                            Header="Master Password"
                            Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                            IsEnabled="{x:Bind views:CreateVaultPage.Not(ViewModel.IsBusy), Mode=OneWay}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                Maximum="4"
                                Value="{x:Bind ViewModel.StrengthValue, Mode=OneWay}"
                                Foreground="{x:Bind views:CreateVaultPage.StrengthBrush(ViewModel.Strength), Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" MinWidth="70" TextAlignment="Right"
                                       Text="{x:Bind ViewModel.StrengthLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>

                        <TextBlock
                            Text="{x:Bind ViewModel.PolicyHint, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Confirmation -->
                    <StackPanel Spacing="6">
                        <PasswordBox
                            Header="Confirmez le Master Password"
                            Password="{x:Bind ViewModel.Confirmation, Mode=TwoWay}"
                            IsEnabled="{x:Bind views:CreateVaultPage.Not(ViewModel.IsBusy), Mode=OneWay}"
                            KeyDown="OnConfirmationKeyDown" />
                        <TextBlock
                            Text="{x:Bind ViewModel.MismatchHint, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>

                    <!-- Avertissement : aucune récupération possible -->
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="Aucune récupération possible"
                        Message="SafeVault ne conserve jamais votre Master Password. Si vous l'oubliez, vos données seront définitivement perdues." />

                    <CheckBox
                        IsChecked="{x:Bind ViewModel.RiskAcknowledged, Mode=TwoWay}"
                        Content="J'ai compris que mon Master Password ne pourra pas être récupéré." />

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Error"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                    <Button
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Créer le coffre"
                        Command="{x:Bind ViewModel.CreateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <TextBlock Text="Créer le coffre" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
