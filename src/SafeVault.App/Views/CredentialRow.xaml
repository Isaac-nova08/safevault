<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SafeVault.App.Views.CredentialRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SafeVault.App.Views">

    <Grid Padding="4,10" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="160" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Pastille du service -->
        <Border Width="40" Height="40" CornerRadius="8"
                Background="{x:Bind views:AvatarPalette.BrushFor(Item.ServiceName), Mode=OneWay}">
            <TextBlock Text="{x:Bind Item.Initial, Mode=OneWay}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" FontWeight="SemiBold" Foreground="White" />
        </Border>

        <!-- Nom et identifiant -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind Item.ServiceName, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Item.Username, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Mot de passe : masqué par défaut, affichage temporaire sur demande -->
        <Grid Grid.Column="2" ColumnSpacing="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="{x:Bind Item.DisplayedPassword, Mode=OneWay}"
                       FontFamily="Cascadia Mono, Consolas"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.Name="Mot de passe" />
            <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Padding="6"
                    Command="{x:Bind Item.ToggleRevealCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Item.RevealTooltip, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Item.RevealTooltip, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind Item.RevealGlyph, Mode=OneWay}" FontSize="14" />
            </Button>
        </Grid>

        <!-- Catégorie -->
        <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left"
                Padding="10,3" CornerRadius="10"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <TextBlock Text="{x:Bind Item.CategoryName, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind Item.CopyUsernameCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Copier l'identifiant"
                    AutomationProperties.Name="Copier l'identifiant">
                <FontIcon Glyph="&#xE77B;" FontSize="16" />
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind Item.CopyPasswordCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Copier le mot de passe"
                    AutomationProperties.Name="Copier le mot de passe">
                <FontIcon Glyph="&#xE8C8;" FontSize="16" />
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind Item.ToggleFavoriteCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Item.FavoriteTooltip, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Item.FavoriteTooltip, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind Item.FavoriteGlyph, Mode=OneWay}" FontSize="16"
                          Foreground="{x:Bind views:CredentialRow.FavoriteBrush(Item.IsFavorite), Mode=OneWay}" />
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind Item.EditCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Modifier"
                    AutomationProperties.Name="Modifier">
                <FontIcon Glyph="&#xE70F;" FontSize="16" />
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind Item.DeleteCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Supprimer"
                    AutomationProperties.Name="Supprimer">
                <FontIcon Glyph="&#xE74D;" FontSize="16" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
