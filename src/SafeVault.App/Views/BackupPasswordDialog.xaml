<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SafeVault.App.Views.BackupPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SafeVault.App.Views"
    Title="{x:Bind ViewModel.Title}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryText}"
    CloseButtonText="Annuler"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="14" Width="440">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Explanation}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="Fichier : " /><Run Text="{x:Bind ViewModel.FileName}" />
            </TextBlock>
        </StackPanel>

        <StackPanel Spacing="6">
            <PasswordBox x:Name="PasswordInput"
                         Header="{x:Bind ViewModel.PasswordHeader}"
                         AutomationProperties.Name="Mot de passe de la sauvegarde"
                         Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
            <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.IsExport}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Maximum="4" VerticalAlignment="Center"
                             Value="{x:Bind ViewModel.StrengthValue, Mode=OneWay}"
                             Foreground="{x:Bind views:CreateVaultPage.StrengthBrush(ViewModel.Strength), Mode=OneWay}" />
                <TextBlock Grid.Column="1" MinWidth="70" TextAlignment="Right"
                           Text="{x:Bind ViewModel.StrengthLabel, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.PolicyHint, Mode=OneWay}" TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.IsExport}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsExport}">
            <PasswordBox Header="Confirmez le mot de passe"
                         AutomationProperties.Name="Confirmation du mot de passe de la sauvegarde"
                         Password="{x:Bind ViewModel.Confirmation, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind ViewModel.MismatchHint, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" />
    </StackPanel>
</ContentDialog>
